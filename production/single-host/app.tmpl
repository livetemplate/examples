<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
    <main class="container">
        <article>
            <header>
                <mark>Production Ready</mark>
                <hgroup>
                    <h1>{{.Title}}</h1>
                    <p>Showcasing production deployment features</p>
                </hgroup>
            </header>

            <details>
                <summary>Enabled Features</summary>
                <ul>
                    <li>Environment-based configuration</li>
                    <li>Structured JSON logging</li>
                    <li>Request tracing with trace IDs</li>
                    <li>Graceful shutdown</li>
                    <li>Health &amp; readiness checks</li>
                    <li>Metrics endpoint</li>
                </ul>
            </details>

            <hgroup>
                <h2>{{.Counter}}</h2>
                <p>Counter Value</p>
            </hgroup>

            <div class="grid">
                <form method="POST" name="increment"><button type="submit" name="increment">+1</button></form>
                <form method="POST" name="decrement"><button type="submit" name="decrement" class="secondary">-1</button></form>
                <form method="POST" name="reset"><button type="submit" name="reset" class="contrast">Reset</button></form>
            </div>

            <footer>
                <small>Last updated: {{.LastUpdated}}</small>
            </footer>
        </article>
    </main>

    {{if .lvt.DevMode}}
    <script src="/livetemplate-client.js"></script>
    {{else}}
    <script src="https://cdn.jsdelivr.net/npm/@livetemplate/client@latest/dist/livetemplate-client.browser.js"></script>
    {{end}}
</body>
</html>
