{{define "content"}}
<article>
    <h3>Progress Bar</h3>
    <p><small>A background goroutine ticks progress from 10% to 100% via WebSocket pushes — no polling.</small></p>
    {{if .Running}}
    <progress value="{{.Progress}}" max="100"></progress>
    <p><small>{{.Progress}}% complete</small></p>
    {{else if .Done}}
    <progress value="100" max="100"></progress>
    <p><small>100% complete</small></p>
    {{/* FlashTag is intentionally rendered only inside the .Done branch:
         flashes are ephemeral (consumed on first render), and the only
         path that emits one is UpdateProgress when Progress >= 100. The
         idle and Running branches don't need a FlashTag slot — there's
         no controller path that emits a flash while either is the active
         render state. */}}
    {{.lvt.FlashTag "success"}}
    <form method="POST">
        <button name="start">Run Again</button>
    </form>
    {{else}}
    <form method="POST">
        <button name="start">Start Job</button>
    </form>
    {{end}}
</article>
{{end}}
