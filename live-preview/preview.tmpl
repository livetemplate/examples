<!DOCTYPE html>
<html>
<head>
    <title>Live Preview</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
    <main class="container">
        <article>
            <header>
                <h1>Live Preview</h1>
            </header>
            <form method="POST">
                <label for="name-input">Name
                    <input id="name-input" name="Name" value="{{.Name}}" placeholder="Type your name...">
                </label>
                <button type="submit">Save</button>
            </form>
            <blockquote id="preview">{{.Preview}}</blockquote>
        </article>
    </main>

    {{if .lvt.DevMode}}
    <script src="/livetemplate-client.js"></script>
    {{else}}
    <script src="https://cdn.jsdelivr.net/npm/@livetemplate/client@latest/dist/livetemplate-client.browser.js"></script>
    {{end}}
</body>
</html>
