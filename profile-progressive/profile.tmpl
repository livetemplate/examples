<!DOCTYPE html>
<html>
<head>
    <title>Progressive Complexity: Profile Demo</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
    <main class="container">
        <hgroup>
            <h1>Edit Profile</h1>
            <p>Zero <code>lvt-*</code> attributes &mdash; Tier 1 only</p>
        </hgroup>

        {{if .Saved}}
            <ins style="display:block;text-decoration:none">Profile saved successfully!</ins>
        {{end}}

        <form method="POST">
            <label for="name">Display Name
                <input type="text" id="name" name="DisplayName" value="{{.DisplayName}}"
                       {{if .lvt.HasError "display_name"}}aria-invalid="true"{{end}}>
                {{if .lvt.HasError "display_name"}}
                    <small>{{.lvt.Error "display_name"}}</small>
                {{end}}
            </label>

            <label for="email">Email
                <input type="email" id="email" name="Email" value="{{.Email}}"
                       {{if .lvt.HasError "email"}}aria-invalid="true"{{end}}>
                {{if .lvt.HasError "email"}}
                    <small>{{.lvt.Error "email"}}</small>
                {{end}}
            </label>

            <label for="bio">Bio
                <textarea id="bio" name="Bio" rows="4">{{.Bio}}</textarea>
                {{if .lvt.HasError "bio"}}
                    <small>{{.lvt.Error "bio"}}</small>
                {{end}}
            </label>

            <button type="submit" name="submit">Save Profile</button>
        </form>

        <article>
            <header><strong>Preview</strong></header>
            <p><strong>Name:</strong> {{.DisplayName}}</p>
            <p><strong>Email:</strong> {{.Email}}</p>
            <p><strong>Bio:</strong> {{.Bio}}</p>
        </article>
    </main>

    {{if .lvt.DevMode}}
    <script src="/livetemplate-client.js"></script>
    {{else}}
    <script src="https://cdn.jsdelivr.net/npm/@livetemplate/client@latest/dist/livetemplate-client.browser.js"></script>
    {{end}}
</body>
</html>
