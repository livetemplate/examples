<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <title>Bookmarks — LiveTemplate</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    {{if .lvt.DevMode}}
    <link rel="stylesheet" href="/livetemplate.css">
    <script defer src="/livetemplate-client.js"></script>
    {{else}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@livetemplate/client@latest/livetemplate.css">
    <script defer src="https://cdn.jsdelivr.net/npm/@livetemplate/client@latest/dist/livetemplate-client.browser.js"></script>
    {{end}}
</head>
<body>
    <main class="container">
        <article>
            <header>
                <hgroup>
                    <h1>{{.Title}}</h1>
                    <p>WebSocket is disabled — the client uses HTTP fetch for all actions</p>
                </hgroup>
            </header>

            {{.lvt.FlashTag "success"}}
            {{.lvt.FlashTag "error"}}

            <form method="POST" name="add">
                <div class="grid">
                    <label>
                        Label
                        <input type="text" name="label" placeholder="My favorite site"
                            {{.lvt.AriaInvalid "label"}}>
                        {{.lvt.ErrorTag "label"}}
                    </label>
                    <label>
                        URL
                        <input type="url" name="url" placeholder="https://example.com"
                            {{.lvt.AriaInvalid "url"}}>
                        {{.lvt.ErrorTag "url"}}
                    </label>
                </div>
                <button type="submit" name="add" {{.lvt.AriaDisabled "label" "url"}}>Add Bookmark</button>
            </form>
        </article>

        <article>
            <header>
                <strong>Bookmarks ({{.Count}})</strong>
            </header>
            {{if not .Bookmarks}}
            <p><small>No bookmarks yet. Add one above!</small></p>
            {{else}}
            <table>
                <tbody>
                {{range .Bookmarks}}
                <tr>
                    <td>
                        <a href="{{.URL}}" target="_blank" rel="noopener">{{.Label}}</a>
                        <small> — {{.URL}}</small>
                    </td>
                    <td>
                        <form method="POST" name="delete" class="inline">
                            <input type="hidden" name="id" value="{{.ID}}">
                            <button type="submit" name="delete" class="compact contrast outline">&#10005;</button>
                        </form>
                    </td>
                </tr>
                {{end}}
                </tbody>
            </table>
            {{end}}
        </article>
    </main>

</body>
</html>
