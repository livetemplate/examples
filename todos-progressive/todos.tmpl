<!DOCTYPE html>
<html>
<head>
    <title>Progressive Complexity: Todo Demo</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
    <main class="container">
        <hgroup>
            <h1>Todos ({{.ActiveCount}} remaining)</h1>
            <p>Zero <code>lvt-*</code> attributes &mdash; standard HTML only</p>
        </hgroup>

        <!-- Auto-submit form: routes to Submit() -->
        <fieldset role="group">
            <input type="text" name="Title" placeholder="What needs to be done?" required
                   form="add-form" {{if .lvt.HasError "title"}}aria-invalid="true"{{end}}>
            <button type="submit" name="submit" form="add-form">Add</button>
        </fieldset>
        <form method="POST" id="add-form"></form>
        {{if .lvt.HasError "title"}}
            <small>{{.lvt.Error "title"}}</small>
        {{end}}

        <!-- Form name="filter" routes to Filter(). Active filter is highlighted. -->
        <div class="grid">
            <form method="POST" name="filter"><input type="hidden" name="filter" value="all"><button type="submit" {{if or (eq .ActiveFilter "") (eq .ActiveFilter "all")}}class="primary"{{else}}class="secondary outline"{{end}}>All</button></form>
            <form method="POST" name="filter"><input type="hidden" name="filter" value="active"><button type="submit" {{if eq .ActiveFilter "active"}}class="primary"{{else}}class="secondary outline"{{end}}>Active</button></form>
            <form method="POST" name="filter"><input type="hidden" name="filter" value="done"><button type="submit" {{if eq .ActiveFilter "done"}}class="primary"{{else}}class="secondary outline"{{end}}>Done</button></form>
        </div>

        <!-- Button name routing: button name="toggle" → Toggle(), name="delete" → Delete() -->
        <table>
            <tbody>
            {{range .FilteredItems}}
                <tr data-key="{{.ID}}">
                    <td>{{if .Done}}<s>{{.Title}}</s>{{else}}{{.Title}}{{end}}</td>
                    <td>
                        <form method="POST">
                            <input type="hidden" name="id" value="{{.ID}}">
                            <button type="submit" name="toggle" class="secondary outline">
                                {{if .Done}}Undo{{else}}Done{{end}}
                            </button>
                        </form>
                    </td>
                    <td>
                        <form method="POST">
                            <input type="hidden" name="id" value="{{.ID}}">
                            <button type="submit" name="delete" class="contrast outline">Delete</button>
                        </form>
                    </td>
                </tr>
            {{end}}
            </tbody>
        </table>

    </main>

    {{if .lvt.DevMode}}
    <script src="/livetemplate-client.js"></script>
    {{else}}
    <script src="https://cdn.jsdelivr.net/npm/@livetemplate/client@latest/dist/livetemplate-client.browser.js"></script>
    {{end}}
</body>
</html>
